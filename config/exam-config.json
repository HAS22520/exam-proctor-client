{
  "exam": {
    "title": "在线考试监考客户端",
    "targetUrl": "https://oj.hntou.fmcf.cc/",
    "allowedDomains": [
      "oj.hntou.fmcf.cc"
    ]
  },
  "globalFirewallLock": {
    "enabled": true
  },
  "window": {
    "kiosk": true,
    "alwaysOnTop": true,
    "preventMinimize": true,
    "disableDevTools": true
  },
  "recording": {
    "enabled": false
  },
  "antiCheat": {
    "blockShortcuts": [
      "Alt+Tab",
      "CommandOrControl+Shift+I",
      "CommandOrControl+R",
      "F5",
      "F11",
      "F12"
    ],
    "processBlacklist": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "WeChat.exe",
      "QQ.exe",
      "DingTalk.exe",
      "Feishu.exe",
      "Telegram.exe",
      "AnyDesk.exe",
      "ToDesk.exe",
      "TeamViewer.exe",
      "clash-verge.exe",
      "verge-mihomo.exe",
      "clash.exe",
      "v2ray.exe"
    ],
    "checkProcessIntervalMs": 3000,
    "singleScreenOnly": true
  }
}
