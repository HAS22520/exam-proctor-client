{
  "exam": {
    "title": "在线考试监考客户端",
    "targetUrl": "https://oj.hntou.fmcf.cc/",
    "allowedDomains": [
      "oj.hntou.fmcf.cc"
    ]
  },
  "updater": {
    "enabled": true,
    "checkOnStartup": true,
    "timeoutMs": 4000,
    "versionUrl": "https://cdn.jsdelivr.net/gh/HAS22520/exam-proctor-client@main/version.json",
    "fallbackVersionUrl": "https://raw.githubusercontent.com/HAS22520/exam-proctor-client/main/version.json"
  },
  "globalFirewallLock": {
    "enabled": true
  },
  "window": {
    "kiosk": true,
    "alwaysOnTop": true,
    "preventMinimize": true,
    "disableDevTools": true
  },
  "recording": {
    "enabled": false
  },
  "antiCheat": {
    "blockShortcuts": [
      "Alt+Tab",
      "CommandOrControl+Shift+I",
      "CommandOrControl+R",
      "F5",
      "F11",
      "F12"
    ],
    "processBlacklist": [
      "Weixin.exe",
      "WeChat.exe",
      "WeChatAppEx.exe",
      "WeChatPlayer.exe",
      "WXWork.exe",
      "QQ.exe",
      "QQEX.exe",
      "QQProtect.exe",
      "TIM.exe",
      "DeepSeek Harness.exe",
      "DeepSeek.exe",
      "ChatGPT.exe",
      "Claude.exe",
      "Kimi.exe",
      "Chatbox.exe",
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "DingTalk.exe",
      "Feishu.exe",
      "Telegram.exe",
      "AnyDesk.exe",
      "ToDesk.exe",
      "TeamViewer.exe",
      "RustDesk.exe",
      "clash-verge.exe",
      "clash_verge.exe",
      "verge-mihomo.exe",
      "clash.exe",
      "v2rayN.exe",
      "v2ray.exe",
      "sing-box.exe",
      "xray.exe",
      "nekoray.exe"
    ],
    "checkProcessIntervalMs": 1500,
    "singleScreenOnly": true
  }
}
