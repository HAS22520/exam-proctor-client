{
  "name": "exam-proctor-client",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "workspaces": [],
  "description": "Hydro 监考客户端：设备认证、加密日志与跨平台考试环境",
  "main": "out/app/main/bootstrap.js",
  "scripts": {
    "build": "node out/scripts/build.js",
    "build:docker": "node out/scripts/build-docker.js",
    "start": "node out/scripts/prepare-build.js && electron .",
    "pack": "node out/scripts/build.js --dir",
    "dist": "node out/scripts/build.js",
    "release:hot": "node out/scripts/build-hot-update.js",
    "test": "node --test out/tests/*.spec.js",
    "test:updates:electron": "node out/scripts/test-update-runtime.js",
    "keys:update": "node out/scripts/update-keys.js",
    "build:native": "node out/scripts/build-native.js",
    "test:native": "node out/scripts/test-native.js",
    "compile": "node --experimental-strip-types scripts/compile.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.tools.json",
    "prebuild": "npm run compile",
    "prebuild:docker": "npm run compile",
    "prestart": "npm run compile",
    "prepack": "npm run compile",
    "predist": "npm run compile",
    "prerelease:hot": "npm run compile",
    "pretest": "npm run compile",
    "pretest:updates:electron": "npm run compile",
    "prekeys:update": "npm run compile",
    "prebuild:native": "npm run compile",
    "pretest:native": "npm run compile"
  },
  "keywords": [
    "proctor",
    "exam",
    "kiosk",
    "whitelist",
    "firewall"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "22.19.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.8.3"
  },
  "build": {
    "appId": "com.exam.proctor",
    "productName": "在线监考客户端",
    "directories": {
      "output": "dist",
      "app": "out"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "scripts",
          "to": "scripts",
          "filter": [
            "unlock-firewall.ps1",
            "restore-network.bat"
          ]
        },
        {
          "from": "build/native",
          "to": "native",
          "filter": [
            "hydro-network.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "HydroProctor-${version}-win-${arch}-setup.${ext}"
    },
    "artifactName": "HydroProctor-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "config/entitlements.mac.plist",
      "entitlementsInherit": "config/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "beforePack": "./out/scripts/before-pack.js",
    "portable": {
      "artifactName": "HydroProctor-${version}-win-${arch}-portable.${ext}"
    }
  },
  "buildVersion": "2026101001"
}
